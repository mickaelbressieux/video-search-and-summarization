export NGC_API_KEY= #api key to pull model from NGC. Add this if you are not using the jupyter notebooks
export NVIDIA_API_KEY="noapikeyset" #need a random string here to avoid bug in endpoint client library; actual key not needed as the endpoint is local
export HF_TOKEN=hf_ #FIXME - api key to pull model from HuggingFace

#Adjust ports if needed
export FRONTEND_PORT=9100
export BACKEND_PORT=8100

#Change default user and pass if needed
export GRAPH_DB_USERNAME=neo4j
export GRAPH_DB_PASSWORD=password

#Update paths local paths to config files if needed
export CA_RAG_CONFIG=./config.yaml
export GUARDRAILS_CONFIG=./guardrails

#Set VLM to Cosmos-Reason2
export VLM_MODEL_TO_USE=openai-compat
export VIA_VLM_ENDPOINT=http://host.docker.internal:38011/v1
export VIA_VLM_OPENAI_MODEL_DEPLOYMENT_NAME=nvidia/cosmos3-nano-reasoner
export VIA_VLM_API_KEY=not-used
export VLM_DEFAULT_NUM_FRAMES_PER_CHUNK=5
export NUM_VLM_PROCS=1


#Adjust misc configs if needed
export DISABLE_GUARDRAILS=true
export NVIDIA_VISIBLE_DEVICES=1

#Set VLM parameters
export VLM_BATCH_SIZE=32
export VLLM_GPU_MEMORY_UTILIZATION=1.0 # Increase this in case of larger models
export VLM_MAX_MODEL_LEN=10240

export DISABLE_CV_PIPELINE=false        # turn the CV pipeline ON
# GDINO_MODEL_PATH: leave UNSET -> auto-downloads
#   ngc:nvidia/tao/grounding_dino:grounding_dino_swin_tiny_commercial_deployable_v1.0
 export INSTALL_PROPRIETARY_CODECS=true   # installs ffmpeg_for_overlay_video (needed for the overlay video artifact in the UI)
export NUM_CV_CHUNKS_PER_GPU=1           # single-GPU box -> keep CV memory footprint small
# GDINO_INFERENCE_INTERVAL: leave unset (default 1 = detect every other frame). Set 0 for max accuracy (heavier).
# CV_PIPELINE_TRACKER_CONFIG: leave UNSET -> use container default /opt/nvidia/via/config/default_tracker_config.yml
